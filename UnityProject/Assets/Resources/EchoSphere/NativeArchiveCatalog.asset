    nameEn: Gravity
    descRu: "\u0420\u043E\u043B\u044C: \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
