  - section: evolutions
    id: sphere-final:orbital:orbital_dance:1
    group: sphere-finals
    nameRu: "\u041E\u0440\u0431\u0438\u0442\u0430\u043B\u044C\u043D\u0430\u044F \xB7
      \u0422\u0430\u043D\u0435\u0446 \u2022 \u0413\u0438\u043F\u0435\u0440\u0446\u0438\u043A\u043B"
