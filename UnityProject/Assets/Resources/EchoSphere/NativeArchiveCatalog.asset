  - section: evolutions
    id: sphere-final:void:void_reaper:2
    group: sphere-finals
    nameRu: "\u041F\u0443\u0441\u0442\u043E\u0442\u043D\u0430\u044F \xB7 \u0416\u043D\u0435\u0446
      \u2022 \u041F\u043E\u0436\u0438\u0440\u0430\u043D\u0438\u0435"
    nameEn: "Void \xB7 Void Reaper \u2022 Devouring Reaper"
    descRu: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
