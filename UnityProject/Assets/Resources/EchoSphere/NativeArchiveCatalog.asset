    descRu: "\u0420\u0435\u0437\u043E\u043D\u0430\u043D\u0441 \u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435, \u0430 \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u0439
      \u043E\u0440\u0431\u0438\u0442\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0437\u0430\u0440\u044F\u0434 \u0449\u0438\u0442\u0430."
