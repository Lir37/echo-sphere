    detailsEn:
  - section: evolutions
    id: ability-evolution:firetrail_sanctum
    group: ability-evolutions
    nameRu: "\u041F\u044B\u043B\u0430\u044E\u0449\u0435\u0435 \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0435"
    nameEn: Burning Sanctuary
    descRu: "\u041F\u0435\u0440\u0435\u0433\u0440\u0435\u0432 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
