    descRu: "\u041F\u043E\u043C\u0435\u0447\u0435\u043D\u043D\u0430\u044F \u0446\u0435\u043B\u044C
      \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u0438\u043B\u044C\u043D\u0435\u0435,
      \u0430 \u0437\u043E\u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
      \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0435\u0451 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u0439\u0441\u044F
      \u044D\u0444\u0444\u0435\u043A\u0442 Anchor."
    descEn: Marked targets are slowed, and the area around them gains a stable network
      anchor.
    detailsRu:
    detailsEn:
  - section: evolutions
    id: sphere-final:sniper:sniper_beacon:1
    group: sphere-finals
    nameRu: "\u0421\u043D\u0430\u0439\u043F\u0435\u0440 \xB7 \u041C\u0430\u044F\u043A
      \u2022 \u041F\u0440\u043E\u0436\u0435\u043A\u0442\u043E\u0440"
