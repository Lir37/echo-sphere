    detailsRu:
    detailsEn:
  - section: evolutions
    id: sphere-branch:void_execution
    group: sphere-branches
    nameRu: "\u041F\u0443\u0441\u0442\u043E\u0442\u043D\u0430\u044F \xB7 \u042D\u043A\u0437\u0435\u043A\u0443\u0446\u0438\u044F"
    nameEn: "Void \xB7 Void Execution"
    descRu: "\u0421\u043B\u0430\u0431\u044B\u0435 \u0446\u0435\u043B\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
      \u0448\u0430\u043D\u0441 \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E\u0435
      \u0434\u043E\u0431\u0438\u0432\u0430\u043D\u0438\u0435, \u0430 \u0430\u0442\u0430\u043A\u0438
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 Phase-\u043F\u0440\u043E\u0431\u0438\u0442\u0438\u0435;
      \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0444\u043E\u0440\u043C\u0430
      \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u043F\u043E\u0440\u043E\u0433
      \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F."
