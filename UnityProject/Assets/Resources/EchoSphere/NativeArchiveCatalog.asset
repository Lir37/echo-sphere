    descRu: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0439
      \u0433\u0440\u0430\u0434 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      8 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432 \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      \u0434\u0432\u0430 \u0441\u043D\u0430\u0440\u044F\u0434\u0430 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0437\u0430\u043B\u043F\u0443."
