    Text: "\u0422\u0410\u0419\u041D\u0418\u041A \u0420\u0415\u0417\u041E\u041D\u0410\u041D\u0421\u0410"
  - Pattern: BREACH NODE
    Text: "\u0423\u0417\u0415\u041B \u041F\u0420\u041E\u0411\u041E\u042F"
  - Pattern: ECHO RELAY
    Text: "\u0420\u0415\u041B\u0415 \u042D\u0425\u0410"
  - Pattern: LOST SIGNAL
    Text: "\u041F\u041E\u0422\u0415\u0420\u042F\u041D\u041D\u042B\u0419 \u0421\u0418\u0413\u041D\u0410\u041B"
  - Pattern: ELITE NEST
    Text: "\u0413\u041D\u0415\u0417\u0414\u041E \u042D\u041B\u0418\u0422\u042B"
  - Pattern: RUPTURE
    Text: "\u0420\u0410\u0417\u0420\u042B\u0412"
  - Pattern: BOSS TRACE
    Text: "\u0421\u041B\u0415\u0414 \u0411\u041E\u0421\u0421\u0410"
  - Pattern: NETWORK FRACTURE
    Text: "\u0420\u0410\u0417\u041B\u041E\u041C \u0421\u0415\u0422\u0418"
  - Pattern: CONDUCTOR BREAK
    Text: "\u0420\u0410\u0417\u0420\u042B\u0412 \u041F\u0420\u041E\u0412\u041E\u0414\u041D\u0418\u041A\u0410"
  - Pattern: CONDUCTOR SURGE
    Text: "\u0418\u041C\u041F\u0423\u041B\u042C\u0421 \u041F\u0420\u041E\u0412\u041E\u0414\u041D\u0418\u041A\u0410"
  - Pattern: GEOMETRY SHIFT
    Text: "\u0421\u0414\u0412\u0418\u0413 \u0413\u0415\u041E\u041C\u0415\u0422\u0420\u0418\u0418"
  - Pattern: ARCHITECT SEAL
    Text: "\u041F\u0415\u0427\u0410\u0422\u042C \u0410\u0420\u0425\u0418\u0422\u0415\u041A\u0422\u041E\u0420\u0410"
  - Pattern: NULL FIELD
    Text: "\u041F\u041E\u041B\u0415 \u041D\u0423\u041B\u042F"
  - Pattern: NULL SHOCK
    Text: "\u0423\u0414\u0410\u0420 \u041D\u0423\u041B\u042F"
  - Pattern: STELLA GUARD
    Text: "\u0421\u0422\u0420\u0410\u0416 \u0421\u0422\u0415\u041B\u041B\u042B"
  - Pattern: STELLA JUDGEMENT
    Text: "\u041F\u0420\u0418\u0413\u041E\u0412\u041E\u0420 \u0421\u0422\u0415\u041B\u041B\u042B"
  - Pattern: CHORUS SYNC
    Text: "\u0421\u0418\u041D\u0425\u0420\u041E\u041D\u0418\u0417\u0410\u0426\u0418\u042F
      \u0425\u041E\u0420\u0410"
  - Pattern: CHORUS PULSE
    Text: "\u0418\u041C\u041F\u0423\u041B\u042C\u0421 \u0425\u041E\u0420\u0410"
  - Pattern: SPLITTER
    Text: "\u0420\u0410\u0421\u041A\u041E\u041B"
  - Pattern: ECHO FREEZE
    Text: "\u042D\u0425\u041E-\u0417\u0410\u041C\u041E\u0420\u041E\u0417\u041A\u0410"
  - Pattern: CLOSED TIME NETWORK
    Text: "\u0417\u0410\u041C\u041A\u041D\u0423\u0422\u0410\u042F \u0421\u0415\u0422\u042C
      \u0412\u0420\u0415\u041C\u0415\u041D\u0418"
  - Pattern: TEMPORAL CORE
    Text: "\u0412\u0420\u0415\u041C\u0415\u041D\u041D\u041E\u0415 \u042F\u0414\u0420\u041E"
