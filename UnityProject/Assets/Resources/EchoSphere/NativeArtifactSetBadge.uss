.native-artifact-set-badge {
    flex-direction: row;
    flex-shrink: 1;
    min-width: 0;
    align-items: center;
    justify-content: flex-start;
    margin: 0;
    padding: 3px 6px 3px 3px;
    border-width: 1px;
    border-color: rgba(255, 184, 77, 0.18);
    border-radius: 19.5px;
    background-color: rgba(255, 184, 77, 0.035);
    background-image: none;
    -unity-text-align: upper-left;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease;
}
.native-artifact-set-badge:hover {
    border-color: rgba(255, 184, 77, 0.52);
    background-color: rgba(255, 184, 77, 0.08);
}
.native-artifact-set-ring {
    width: 31px;
    height: 31px;
    flex-shrink: 0;
    margin-right: 7px;
    padding: 3px;
    align-items: center;
    justify-content: center;
}
.native-artifact-set-hole {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    background-color: rgb(7, 17, 29);
    align-items: center;
    justify-content: center;
}
