        Id: standard_singularity_final_2
      - NameRu: "\u0421\u0438\u043D\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C
          \u2022 \u041A\u043E\u043B\u043B\u0430\u043F\u0441"
        NameEn: "Standard Singularity \u2022 Collapse"
        DescriptionRu: "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0441\u0438\u043B\u044C\u043D\u0435\u0435
          \u0441\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432;
          \u0446\u0435\u043B\u0438 \u043D\u0438\u0436\u0435 50% HP \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
          +15% \u0443\u0440\u043E\u043D\u0430."
        DescriptionEn: Hits pull enemies harder, and targets below 50% HP take 15%
          more damage.
        Id: standard_singularity_final_3
    - NameRu: "\u0420\u043E\u0439"
      NameEn: Standard Swarm
      DescriptionRu: "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044E\u0442
        \u043E\u0441\u043A\u043E\u043B\u043A\u0438"
      DescriptionEn: Develops the Standard Swarm branch and its signature behavior.
      Id: standard_swarm
      Element: poison
      BranchCard:
        NameRu: "\u0420\u043E\u0439"
        NameEn: Standard Swarm
        DescriptionRu: "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044E\u0442
