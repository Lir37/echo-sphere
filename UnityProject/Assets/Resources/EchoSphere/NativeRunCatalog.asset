    Branches:
    - NameRu: "\u042D\u0445\u043E-\u0434\u0440\u043E\u043D"
      NameEn: Echo Drone
      DescriptionRu: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
        \u0441\u0444\u0435\u0440\u0430 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
