      - NameRu: "\u0421\u043F\u0435\u043A\u0442\u0440 \u2022 \u0422\u043E\u043A\u0441\u0438\u043D
          \u2022 \u0414\u043E\u043B\u0433\u0438\u0439 \u0442\u043E\u043A\u0441\u0438\u043D"
        NameEn: "Prism Spectrum \u2022 Toxin \u2022 Lingering Venom"
