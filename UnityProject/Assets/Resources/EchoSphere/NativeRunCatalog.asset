    - NameRu: "\u0413\u0440\u0430\u0434"
      NameEn: Shotgun Hail
      DescriptionRu: "\u041C\u043D\u043E\u0433\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
