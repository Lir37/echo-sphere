          \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
          \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F. \u2620\uFE0F \u0421\u0442\u0438\u0445\u0438\u044F:
