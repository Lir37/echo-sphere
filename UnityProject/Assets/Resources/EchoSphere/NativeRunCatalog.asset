          \u0430\u0442\u0430\u043A\u0443 \u043F\u043E\u0447\u0442\u0438 \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u043D\u043E.
          +45% \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
          \u044F\u0434\u0430 \u043E\u0442 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0439
