      FinalCards:
      - NameRu: "\u0412\u0441\u043F\u044B\u0448\u043A\u0430 \u2022 \u0420\u0430\u0441\u043A\u043E\u043B
          \u2022 \u041F\u043E\u043B\u0435 \u2022 \u0421\u0438\u043B\u0430"
