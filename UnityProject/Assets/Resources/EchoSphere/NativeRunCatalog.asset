  Spheres:
  - NameRu: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0430\u044F"
    NameEn: Standard
    DescriptionRu: "\u0421\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u0441\u0444\u0435\u0440\u0430"
    DescriptionEn: Balanced sphere
    Id: standard
    Color: '#55dfff'
    RangeMultiplier: 1
    Projectile: 1
    Branches:
    - NameRu: "\u0420\u0435\u0437\u043E\u043D\u0430\u0442\u043E\u0440"
      NameEn: Standard Resonator
      DescriptionRu: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0442\u0440\u0435\u0442\u044C\u0435
        \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
        \u0438\u043C\u043F\u0443\u043B\u044C\u0441; \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F
        \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u0434\u043F\u0438\u0442\u044B\u0432\u0430\u044E\u0442
        Resonance"
      DescriptionEn: Every third hit releases a pulse, while hits also feed Resonance.
      Id: standard_resonator
      Element: fire
      BranchCard:
        NameRu: "\u0420\u0435\u0437\u043E\u043D\u0430\u0442\u043E\u0440"
        NameEn: Standard Resonator
        DescriptionRu: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0442\u0440\u0435\u0442\u044C\u0435
          \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
          \u0438\u043C\u043F\u0443\u043B\u044C\u0441; \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F
          \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u0434\u043F\u0438\u0442\u044B\u0432\u0430\u044E\u0442
          Resonance \U0001F525 \u0421\u0442\u0438\u0445\u0438\u044F: \u041E\u0433\u043E\u043D\u044C."
        DescriptionEn: "Every third hit releases a pulse, while hits also feed Resonance.
          \U0001F525 Element: Fire."
      FinalCards:
      - NameRu: "\u0420\u0435\u0437\u043E\u043D\u0430\u0442\u043E\u0440 \u2022 \u0418\u043C\u043F\u0443\u043B\u044C\u0441
          \u2022 \u0420\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u043E\u0435
          \u043F\u043B\u0430\u043C\u044F"
        NameEn: "Standard Resonator \u2022 Pulse \u2022 Incineration"
        DescriptionRu: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0442\u0440\u0435\u0442\u044C\u0435
          \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
          \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u044B\u0439 \u0438\u043C\u043F\u0443\u043B\u044C\u0441
          \u0432\u043E\u043A\u0440\u0443\u0433 \u0446\u0435\u043B\u0438: 65% \u0443\u0440\u043E\u043D\u0430,
          \u0440\u0430\u0434\u0438\u0443\u0441 115. +35% \u0443\u0440\u043E\u043D\u0430
          \u0433\u043E\u0440\u0435\u043D\u0438\u044F."
        DescriptionEn: 'Every third hit creates an empowered pulse around the target:
          65% damage, radius 115. +35% burn damage.'
      - NameRu: "\u0420\u0435\u0437\u043E\u043D\u0430\u0442\u043E\u0440 \u2022 \u041E\u0442\u0431\u043E\u0439
          \u2022 \u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u0433\u043E\u0440\u0435\u043D\u0438\u0435"
        NameEn: "Standard Resonator \u2022 Rebound \u2022 Rapid Combustion"
        DescriptionRu: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0442\u0440\u0435\u0442\u044C\u0435
          \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
          \u0438\u043C\u043F\u0443\u043B\u044C\u0441 \u043F\u043E \u043F\u043B\u043E\u0449\u0430\u0434\u0438:
          45% \u0443\u0440\u043E\u043D\u0430 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435
          100 \u0438 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
          \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445 \u0432\u0440\u0430\u0433\u043E\u0432.
          \u0413\u043E\u0440\u0435\u043D\u0438\u0435 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
          \u0441\u0432\u043E\u0439 \u0443\u0440\u043E\u043D \u0431\u043E\u043B\u0435\u0435
          \u0447\u0430\u0441\u0442\u044B\u043C\u0438 \u0442\u0438\u043A\u0430\u043C\u0438."
        DescriptionEn: 'Every third hit creates an area pulse: 45% damage in radius
          100 and knocks back nearby enemies. Burn deals its damage in more frequent
          ticks.'
      - NameRu: "\u0420\u0435\u0437\u043E\u043D\u0430\u0442\u043E\u0440 \u2022 \u0421\u0440\u044B\u0432
          \u2022 \u041D\u0435\u0443\u0433\u0430\u0441\u0430\u0435\u043C\u044B\u0439
          \u043E\u0433\u043E\u043D\u044C"
        NameEn: "Standard Resonator \u2022 Suppression \u2022 Endless Flame"
        DescriptionRu: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0442\u0440\u0435\u0442\u044C\u0435
          \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
          \u0438\u043C\u043F\u0443\u043B\u044C\u0441: 35% \u0443\u0440\u043E\u043D\u0430
          \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 90 \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442
          \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445 \u0432\u0440\u0430\u0433\u043E\u0432
          \u043D\u0430 0.8 \u0441. +45% \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
          \u0433\u043E\u0440\u0435\u043D\u0438\u044F."
        DescriptionEn: 'Every third hit creates a pulse: 35% damage in radius 90
          and slows nearby enemies for 0.8s. +45% burn duration.'
      HasFinalPool: 0
      Finals:
      - NameRu: "\u0420\u0435\u0437\u043E\u043D\u0430\u0442\u043E\u0440 \u2022 \u0418\u043C\u043F\u0443\u043B\u044C\u0441"
        NameEn: "Standard Resonator \u2022 Pulse"
        DescriptionRu: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0442\u0440\u0435\u0442\u044C\u0435
          \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
